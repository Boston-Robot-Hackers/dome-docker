# syntax=docker/dockerfile:1.7
ARG ROS_DISTRO=kilted
ARG UBUNTU_CODENAME=noble
FROM ros:${ROS_DISTRO}-ros-base-${UBUNTU_CODENAME}

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive
ARG ROS_DISTRO=kilted
ENV ROS_DISTRO=${ROS_DISTRO}

COPY manifest/ /manifest/

RUN apt-get update && \
    awk '/^\[apt\]/{f=1;next} /^\[/{f=0} f && /^[^#[:space:]]/' /manifest/packages.txt \
      | xargs apt-get install -y --no-install-recommends && \
    awk -v d="${ROS_DISTRO}" '/^\[ros\]/{f=1;next} /^\[/{f=0} f && /^[^#[:space:]]/{print "ros-"d"-"$0}' /manifest/packages.txt \
      | xargs apt-get install -y --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

# Dockerfile RUN steps execute as root, so the host-side "sudo sh" form is not needed here.
RUN curl -LSfs https://raw.githubusercontent.com/cantino/mcfly/master/ci/install.sh | sh -s -- --git cantino/mcfly

RUN apt-get install -y apt-transport-https gnupg && \
    curl -sLf --retry 3 --tlsv1.2 --proto "=https" \
      'https://packages.doppler.com/public/cli/gpg.DE2A7741A397C129.key' \
      | gpg --dearmor -o /usr/share/keyrings/doppler-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/doppler-archive-keyring.gpg] https://packages.doppler.com/public/cli/deb/debian any-version main" \
      > /etc/apt/sources.list.d/doppler-cli.list && \
    apt-get update && apt-get install -y doppler && \
    rm -rf /var/lib/apt/lists/*

RUN if grep -q '^[^#[:space:]]' /manifest/pip.txt 2>/dev/null; then \
      awk '/^[^#[:space:]]/ && NF' /manifest/pip.txt | xargs pip3 install --break-system-packages; \
    fi

RUN rosdep init || true
