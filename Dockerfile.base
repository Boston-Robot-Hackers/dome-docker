# syntax=docker/dockerfile:1.7
ARG ROS_DISTRO=kilted
ARG UBUNTU_CODENAME=noble
FROM ros:${ROS_DISTRO}-ros-base-${UBUNTU_CODENAME}

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive
ARG ROS_DISTRO=kilted
ENV ROS_DISTRO=${ROS_DISTRO}

COPY manifest/ /manifest/

RUN apt-get update && \
    (awk '/^\[apt\]/{f=1;next} /^\[/{f=0} f && /^[^#[:space:]]/' /manifest/packages.txt; \
     awk '/^\[apt-pi\]/{f=1;next} /^\[/{f=0} f && /^[^#[:space:]]/' /manifest/packages.txt) \
      | xargs apt-get install -y --no-install-recommends && \
    awk -v d="${ROS_DISTRO}" '/^\[ros\]/{f=1;next} /^\[/{f=0} f && /^[^#[:space:]]/{print "ros-"d"-"$0}' /manifest/packages.txt \
      | xargs apt-get install -y --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

RUN source /manifest/lib.sh && \
    for sect in $(manifest_sections /manifest/tools.txt); do \
      method=$(manifest_field "$sect" method /manifest/tools.txt); \
      url=$(manifest_field "$sect" url /manifest/tools.txt); \
      args=$(manifest_field "$sect" args /manifest/tools.txt); \
      if [[ "$method" == "curl-sh" ]]; then \
        curl -LSfs "$url" | sh -s -- $args; \
      fi; \
    done

RUN source /manifest/lib.sh && \
    apt-get install -y apt-transport-https gnupg && \
    arch=$(dpkg --print-architecture) && \
    for sect in $(manifest_sections /manifest/apt-repos.txt); do \
      key_url=$(manifest_field "$sect" key_url /manifest/apt-repos.txt); \
      key_file=$(manifest_field "$sect" key_file /manifest/apt-repos.txt); \
      key_dearmor=$(manifest_field "$sect" key_dearmor /manifest/apt-repos.txt); \
      list=$(manifest_field "$sect" list /manifest/apt-repos.txt); \
      list="${list//\{arch\}/$arch}"; \
      list="${list//\{key_file\}/$key_file}"; \
      if [[ "$key_dearmor" == "yes" ]]; then \
        curl -sLf --retry 3 --tlsv1.2 --proto "=https" "$key_url" | gpg --dearmor -o "$key_file"; \
      else \
        curl -fsSL --retry 3 --tlsv1.2 --proto "=https" "$key_url" -o "$key_file" && chmod go+r "$key_file"; \
      fi; \
      echo "$list" > "/etc/apt/sources.list.d/${sect}.list"; \
    done && \
    apt-get update && \
    awk '/^\[/{next} /^packages[[:space:]]*=/{sub(/^packages[[:space:]]*=[[:space:]]*/,""); print}' /manifest/apt-repos.txt \
      | tr ' ' '\n' | grep -v '^$' | xargs apt-get install -y && \
    rm -rf /var/lib/apt/lists/*

RUN (awk '/^\[pip\]/{f=1;next} /^\[/{f=0} f && /^[^#[:space:]]/' /manifest/pip.txt; \
     awk '/^\[pip-pi\]/{f=1;next} /^\[/{f=0} f && /^[^#[:space:]]/' /manifest/pip.txt) \
      | xargs pip3 install --break-system-packages --ignore-installed

RUN rosdep init || true
